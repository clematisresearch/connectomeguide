"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"HbnXEvKbJd"}],"key":"bNz7AuSduU"},{"type":"text","value":" that physically link neurons and brain regions, and the ","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"qSr4rSOYRz"},{"type":"strong","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"functional connections","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"E23L7rZAiv"}],"key":"abkkiRCs2k"},{"type":"text","value":" that emerge when different parts of the brain coordinate their activity.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"f14957Xlza"}],"key":"sNyEt9sRI9"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"In Connectome2026, you will work with real scientific datasets and modern research tools to explore these questions firsthand. You will analyze the cutting-edge datasets used by researchers around the world and investigate open questions about how brains are organized and how they function.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"JdWS60AdGn"}],"key":"TgkRspTIZ6"},{"type":"heading","depth":2,"position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Competition Tracks","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"NqhxDIiUXa"}],"identifier":"competition-tracks","label":"Competition Tracks","html_id":"competition-tracks","implicit":true,"key":"zZbi4wo7QQ"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"To help participants explore connectomics across multiple scales, the competition is organized into two complementary tracks.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}}